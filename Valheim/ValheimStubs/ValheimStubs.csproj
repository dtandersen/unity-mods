<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Compile-only fakes of the Valheim API surface the mod uses.
         Referenced only when the real game DLLs are absent (CI). Never shipped,
         never deployed. AssemblyName matches the real assembly_valheim.dll.
         BepInEx/Jotunn/Harmony resolve from the real vendored DLLs in lib/;
         only the game + Unity glue is faked here. UnityEngine core types come
         from UnityStubs. Keep net48 so it links cleanly with the mod. -->
    <AssemblyName>assembly_valheim</AssemblyName>
    <RootNamespace>ValheimStubs</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Fields/events mirror the game API; nothing in the stub project reads them. -->
    <NoWarn>$(NoWarn);CS0067;CS0069;CS0414;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UnityStubs\UnityStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>

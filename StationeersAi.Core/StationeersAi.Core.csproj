<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StationeersAi.Core</AssemblyName>
    <RootNamespace>StationeersAi.Core</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Unity-free core logic for the Stationeers AI assistant.</Description>
  </PropertyGroup>

  <!--
    Deliberately no Unity / Stationeers / BepInEx references. Everything here must be
    testable from StationeersAi.Test without the game running. Presentation and
    domain logic may use the agent engine; the engine never points back.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Caev\Caev.csproj" />
    <ProjectReference Include="..\StationeersAi.Common\StationeersAi.Common.csproj" />
  </ItemGroup>

  <!--
    Newtonsoft ships with Stationeers, so we compile against it but do not ship our own
    copy; at runtime the game's assembly is used.
  -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>

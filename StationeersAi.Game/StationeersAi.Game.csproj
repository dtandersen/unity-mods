<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Sage - Unity and Stationeers adapters (repositories, window, HTTP server, mod lifecycle).</Description>
    <!-- Land beside the plugin so BepInEx loads one folder. -->
    <DeployFolderName>StationeersAi.Mod</DeployFolderName>
  </PropertyGroup>

  <!-- The adapter consumes the Unity-free agent and core libraries. -->
  <ItemGroup>
    <ProjectReference Include="..\Caev\Caev.csproj" />
    <ProjectReference Include="..\StationeersAi.Common\StationeersAi.Common.csproj" />
    <ProjectReference Include="..\StationeersAi.Core\StationeersAi.Core.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\stationeers.targets" />

</Project>

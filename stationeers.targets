<Project>

  <!-- Optional machine-specific overrides (git-ignored). -->
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />

  <PropertyGroup>
    <AssemblyName>$(ProjectName)</AssemblyName>
    <RootNamespace>$(ProjectName)</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Find the game install if the user did not set GamePath (Steam App 544550). -->
  <Choose>
    <When Condition="($(OS) == 'Unix' OR $(OS) == 'OSX') AND $(GamePath) == ''">
      <PropertyGroup>
        <GamePath Condition="!Exists('$(GamePath)')">$(HOME)/.steam/steam/steamapps/common/Stationeers</GamePath>
      </PropertyGroup>
    </When>
    <When Condition="$(OS) == 'Windows_NT' AND $(GamePath) == ''">
      <PropertyGroup>
        <GamePath Condition="!Exists('$(GamePath)')">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 544550', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</GamePath>
        <_SteamLibraryPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry32))</_SteamLibraryPath>
        <GamePath Condition="!Exists('$(GamePath)') AND '$(_SteamLibraryPath)' != ''">$(_SteamLibraryPath)\steamapps\common\Stationeers</GamePath>
        <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files (x86)\Steam\steamapps\common\Stationeers</GamePath>
      </PropertyGroup>
    </When>
  </Choose>

  <PropertyGroup>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(GamePath)/BepInEx</BepInExPath>
    <!-- Stationeers managed assemblies live under rocketstation_Data/Managed. -->
    <ManagedDataPath Condition="'$(ManagedDataPath)' == '' AND Exists('$(GamePath)/rocketstation_Data/Managed')">$(GamePath)/rocketstation_Data/Managed</ManagedDataPath>
    <ManagedDataPath Condition="'$(ManagedDataPath)' == ''">$(GamePath)/rocketstation_Data/Managed</ManagedDataPath>
    <UnityPath Condition="'$(UnityPath)' == ''">$(ManagedDataPath)</UnityPath>
    <PluginDeployDir Condition="'$(PluginDeployDir)' == ''">$(BepInExPath)\plugins</PluginDeployDir>
    <!-- Folder the plugin is deployed into under the plugins folder. -->
    <DeployFolderName Condition="'$(DeployFolderName)' == ''">$(MSBuildProjectName)</DeployFolderName>
    <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">true</DeployOnBuild>
    <PackageOnBuild Condition="'$(PackageOnBuild)' == ''">false</PackageOnBuild>
    <!-- LaunchPad Local mod layout (Documents/My Games/Stationeers/mods/<LocalModFolderName>/
         with About/About.xml plus the plugin DLLs at the root). Off by default;
         pass -p:DeployLocalOnBuild=true to copy there on build. -->
    <LocalModsPath Condition="'$(LocalModsPath)' == ''">$(USERPROFILE)\Documents\My Games\Stationeers\mods</LocalModsPath>
    <LocalModFolderName Condition="'$(LocalModFolderName)' == ''">Sage</LocalModFolderName>
    <DeployLocalOnBuild Condition="'$(DeployLocalOnBuild)' == ''">false</DeployLocalOnBuild>
    <!-- Compile against minimal source stubs when the game is absent (CI).
         Auto-on when Assembly-CSharp.dll is missing; force with
         -p:UseGameStubs=true to test the stub build locally. Real game DLLs
         take precedence whenever they exist. -->
    <UseGameStubs Condition="'$(UseGameStubs)' == '' AND !Exists('$(ManagedDataPath)\Assembly-CSharp.dll')">true</UseGameStubs>
    <UseGameStubs Condition="'$(UseGameStubs)' == ''">false</UseGameStubs>
  </PropertyGroup>

  <!-- Makes the project build even on machines without the .NET Framework 4.8 targeting pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- BepInEx -->
  <ItemGroup Condition="Exists('$(BepInExPath)\core\BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Vendored fallback (e.g. CI): used only when BepInEx is not installed
       alongside the game. The game-local copy above takes precedence. -->
  <ItemGroup Condition="!Exists('$(BepInExPath)\core\BepInEx.dll') AND Exists('$(MSBuildThisFileDirectory)lib\BepInEx\BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(MSBuildThisFileDirectory)lib\BepInEx\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildThisFileDirectory)lib\BepInEx\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Stationeers assemblies. Skipped when compiling against source stubs. -->
  <Target Name="CheckGameRefs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagedDataPath)\Assembly-CSharp.dll') AND '$(UseGameStubs)' != 'true'"
           Text="Stationeers game DLL not found at $(ManagedDataPath)\Assembly-CSharp.dll. Set GamePath in local.props (e.g. D:\SteamLibrary\steamapps\common\Stationeers)." />
    <Warning Condition="'$(UseGameStubs)' == 'true'"
             Text="Compiling against minimal Stationeers stubs (no game install). Game behavior is faked for compile only." />
    <Warning Condition="!Exists('$(BepInExPath)\core\BepInEx.dll') AND !Exists('$(MSBuildThisFileDirectory)lib\BepInEx\BepInEx.dll')"
             Text="BepInEx not found at $(BepInExPath)\core\BepInEx.dll. Install BepInEx 5 (x64, Mono) into the game folder." />
  </Target>
  <ItemGroup Condition="'$(UseGameStubs)' != 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDataPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDataPath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RG.ImGui">
      <HintPath>$(ManagedDataPath)\RG.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RG.ImGui.Unity">
      <HintPath>$(ManagedDataPath)\RG.ImGui.Unity.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity assemblies. Skipped when compiling against source stubs. -->
  <ItemGroup Condition="'$(UseGameStubs)' != 'true'">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(UnityPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(UnityPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(UnityPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(UnityPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(UnityPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDataPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Minimal source stubs (CI): same namespaces as the game, compile only.
       Real game DLLs take precedence; this runs only when UseGameStubs=true.
       Game stubs (Assembly-CSharp) pull in Unity stubs (UnityEngine)
       transitively, which also satisfies BepInEx's UnityEngine reference.
       Private=false keeps the fake DLLs out of the output, deploy, and zip. -->
  <ItemGroup Condition="'$(UseGameStubs)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Stationeers/StationeersStubs\StationeersStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)UnityStubs\UnityStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy the built plugin into the BepInEx plugins folder. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <PropertyGroup>
      <_DeployDir>$(PluginDeployDir)\$(DeployFolderName)</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Target DLL/pdb plus any copy-local dependencies. -->
      <_ModFiles Include="$(TargetDir)*.dll" />
      <_ModFiles Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(_DeployDir)" />
    <Copy SourceFiles="@(_ModFiles)" DestinationFolder="$(_DeployDir)" />
    <Message Importance="high" Text="Deployed $(ProjectName) to $(_DeployDir)" />
  </Target>

  <!-- Copy the built plugin into the LaunchPad Local mods folder, when asked.
       Same DLLs as the BepInEx deploy, plus About/About.xml at the mod root.
       LaunchPad loads any BaseUnityPlugin under the mod folder, so no code
       change is needed for the second path. --> 
  <Target Name="DeployLocal" AfterTargets="Build" Condition="'$(DeployLocalOnBuild)' == 'true'">
    <PropertyGroup>
      <_LocalDir>$(LocalModsPath)\$(LocalModFolderName)</_LocalDir>
    </PropertyGroup>
    <ItemGroup>
      <_LocalFiles Include="$(TargetDir)*.dll" />
      <_LocalFiles Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(_LocalDir)\About" />
    <Copy SourceFiles="@(_LocalFiles)" DestinationFolder="$(_LocalDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/About/About.xml" DestinationFolder="$(_LocalDir)\About" Condition="Exists('$(MSBuildProjectDirectory)/About/About.xml')" />
    <Message Importance="high" Text="Deployed Local mod to $(_LocalDir)" />
  </Target>

  <!-- Optionally package a single distribution zip (sage-<version>.zip) that runs
       either way. The zip holds the plugin DLLs plus About/About.xml at the
       root: extract it into BepInEx/plugins/Sage/ for plain BepInEx, or into
       Documents/My Games/Stationeers/mods/Sage/ for LaunchPad Local
       (LaunchPad finds any BaseUnityPlugin under the mod folder). -->
  <Target Name="Package" AfterTargets="Build" Condition="'$(PackageOnBuild)' == 'true'">
    <PropertyGroup>
      <_PackageStage>$(IntermediateOutputPath)package/</_PackageStage>
      <_ArtifactsDir>$(ProjectDir)artifacts/</_ArtifactsDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Target DLL plus copy-local dependencies. -->
      <_PackageFiles Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(_PackageStage)" />
    <MakeDir Directories="$(_PackageStage)About" />
    <Copy SourceFiles="@(_PackageFiles)" DestinationFolder="$(_PackageStage)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/About/About.xml" DestinationFolder="$(_PackageStage)About" Condition="Exists('$(MSBuildProjectDirectory)/About/About.xml')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../README.md" DestinationFolder="$(_PackageStage)" Condition="Exists('$(MSBuildProjectDirectory)/../../README.md')" />
    <MakeDir Directories="$(_ArtifactsDir)" />
    <ZipDirectory SourceDirectory="$(_PackageStage)"
                  DestinationFile="$(_ArtifactsDir)sage-$(Version).zip"
                  Overwrite="true" />
    <Message Importance="high" Text="Packaged $(_ArtifactsDir)sage-$(Version).zip" />
  </Target>

</Project>

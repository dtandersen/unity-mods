<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Fake UnityEngine assembly (compile only, CI). AssemblyName matches the
         real UnityEngine.dll so BepInEx types referencing UnityEngine.KeyCode
         unify with these stubs. -->
    <AssemblyName>UnityEngine</AssemblyName>
    <RootNamespace>UnityEngine</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Sage - Unity and Stationeers adapters (repositories, window, HTTP server, mod lifecycle).</Description>
    <!-- Library: its DLL is copy-localled into Sage.Mod and deployed from
         there, so it never deploys itself. -->
  </PropertyGroup>

  <!-- The adapter consumes the Unity-free agent and core libraries. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Caev\Caev.csproj" />
    <ProjectReference Include="..\..\Common\Common.csproj" />
    <ProjectReference Include="..\Sage.Core\Sage.Core.csproj" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\stationeers.targets" />

  <!-- Null checks on: overrides the disable in stationeers.targets.
       Library: never deploys itself; its DLL is copy-localled into
       Sage.Mod and deployed from there. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <DeployOnBuild>false</DeployOnBuild>
  </PropertyGroup>

</Project>

<!--
  Copy per-game example files instead of this one:

    Stationeers/local.props.example   -> Stationeers/local.props
    Valheim/local.props.example       -> Valheim/local.props
    DriverAssist/local.props.example  -> DriverAssist/local.props

  Each *.targets reads the root local.props first (if present), then its own
  per-game local.props (per-game wins). The per-game files use per-game
  property names, so one game's path can never redirect another game's build:

    StationeersGamePath   ValheimGamePath   DerailValleyPath

  Legacy <GamePath> is honored only when it points at the matching game.
  This root file is optional; prefer the per-game files above.
-->
<Project>
  <PropertyGroup>
    <!-- Stationeers install directory (contains rocketstation.exe and rocketstation_Data/). -->
    <!-- <StationeersGamePath>D:\SteamLibrary\steamapps\common\Stationeers</StationeersGamePath> -->

    <!-- Valheim install directory (contains valheim.exe and valheim_Data/). -->
    <!-- <ValheimGamePath>D:\SteamLibrary\steamapps\common\Valheim</ValheimGamePath> -->

    <!-- Derail Valley install directory (contains DerailValley.exe and DerailValley_Data/). -->
    <!-- <DerailValleyPath>D:\SteamLibrary\steamapps\common\Derail Valley</DerailValleyPath> -->
  </PropertyGroup>
</Project>

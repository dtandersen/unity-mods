<Project>

  <!-- Optional machine-specific overrides (git-ignored). -->
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />

  <PropertyGroup>
    <AssemblyName>$(ProjectName)</AssemblyName>
    <RootNamespace>$(ProjectName)</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Find the game install if the user did not set GamePath. -->
  <Choose>
    <When Condition="($(OS) == 'Unix' OR $(OS) == 'OSX') AND $(GamePath) == ''">
      <PropertyGroup>
        <GamePath Condition="!Exists('$(GamePath)')">$(HOME)/.steam/steam/steamapps/common/Valheim</GamePath>
        <GamePath Condition="!Exists('$(GamePath)')">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim/Contents/MacOS</GamePath>
      </PropertyGroup>
    </When>
    <When Condition="$(OS) == 'Windows_NT' AND $(GamePath) == ''">
      <PropertyGroup>
        <GamePath Condition="!Exists('$(GamePath)')">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 892970', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</GamePath>
        <_SteamLibraryPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry32))</_SteamLibraryPath>
        <GamePath Condition="!Exists('$(GamePath)') AND '$(_SteamLibraryPath)' != ''">$(_SteamLibraryPath)\steamapps\common\Valheim</GamePath>
        <GamePath Condition="!Exists('$(GamePath)')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
      </PropertyGroup>
    </When>
  </Choose>

  <PropertyGroup>
    <BepInExPath Condition="'$(BepInExPath)' == ''">$(GamePath)/BepInEx</BepInExPath>
    <!-- Dedicated server (steamcmd app 896660) uses valheim_server_Data instead of valheim_Data. -->
    <ManagedDataPath Condition="'$(ManagedDataPath)' == '' AND Exists('$(GamePath)/valheim_Data/Managed')">$(GamePath)/valheim_Data/Managed</ManagedDataPath>
    <ManagedDataPath Condition="'$(ManagedDataPath)' == '' AND Exists('$(GamePath)/valheim_server_Data/Managed')">$(GamePath)/valheim_server_Data/Managed</ManagedDataPath>
    <ManagedDataPath Condition="'$(ManagedDataPath)' == ''">$(GamePath)/valheim_Data/Managed</ManagedDataPath>
    <UnityPath Condition="'$(UnityPath)' == ''">$(ManagedDataPath)</UnityPath>
    <PluginDeployDir Condition="'$(PluginDeployDir)' == ''">$(BepInExPath)\plugins</PluginDeployDir>
    <!-- Folder the plugin is deployed into. Set this to the name r2modman used for a
         locally imported mod so builds update the managed copy instead of adding a second one. -->
    <DeployFolderName Condition="'$(DeployFolderName)' == ''">$(ProjectName)</DeployFolderName>
    <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">true</DeployOnBuild>
    <PackageOnBuild Condition="'$(PackageOnBuild)' == ''">false</PackageOnBuild>
    <!-- Compile against minimal source stubs when the game is absent (CI).
         Auto-on when assembly_valheim.dll is missing; force with
         -p:UseGameStubs=true to test the stub build locally. Real game DLLs
         take precedence whenever they exist. BepInEx/Jotunn/Harmony always
         resolve from the real DLLs (game install first, lib/ fallback). -->
    <UseGameStubs Condition="'$(UseGameStubs)' == '' AND !Exists('$(ManagedDataPath)\assembly_valheim.dll')">true</UseGameStubs>
    <UseGameStubs Condition="'$(UseGameStubs)' == ''">false</UseGameStubs>
  </PropertyGroup>

  <!-- Makes the project build even on machines without the .NET Framework 4.8 targeting pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- BepInEx (game install first, vendored fallback for CI) -->
  <ItemGroup Condition="Exists('$(BepInExPath)\core\BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Vendored fallback (e.g. CI): used only when BepInEx is not installed
       alongside the game. The game-local copy above takes precedence. -->
  <ItemGroup Condition="!Exists('$(BepInExPath)\core\BepInEx.dll') AND Exists('$(MSBuildThisFileDirectory)lib\BepInEx\BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>$(MSBuildThisFileDirectory)lib\BepInEx\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildThisFileDirectory)lib\BepInEx\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Jotunn (optional dependency; present when installed via the mod manager) -->
  <ItemGroup Condition="Exists('$(PluginDeployDir)\ValheimModding-Jotunn\Jotunn.dll')">
    <Reference Include="Jotunn">
      <HintPath>$(PluginDeployDir)\ValheimModding-Jotunn\Jotunn.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Vendored fallback (e.g. CI): used only when Jotunn is not installed
       alongside the game. The mod-manager copy above takes precedence. -->
  <ItemGroup Condition="!Exists('$(PluginDeployDir)\ValheimModding-Jotunn\Jotunn.dll') AND Exists('$(MSBuildThisFileDirectory)lib\Jotunn\Jotunn.dll')">
    <Reference Include="Jotunn">
      <HintPath>$(MSBuildThisFileDirectory)lib\Jotunn\Jotunn.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Valheim assemblies. Skipped when compiling against source stubs. -->
  <ItemGroup Condition="'$(UseGameStubs)' != 'true'">
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDataPath)\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDataPath)\assembly_utils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDataPath)\assembly_guiutils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>$(ManagedDataPath)\gui_framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity assemblies. Skipped when compiling against source stubs
       (UnityEngine core types come from UnityStubs instead). -->
  <ItemGroup Condition="'$(UseGameStubs)' != 'true'">
    <Reference Include="UnityEngine">
      <HintPath>$(UnityPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(UnityPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(UnityPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(UnityPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(UnityPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(UnityPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(UnityPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(UnityPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(UnityPath)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(UnityPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDataPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Minimal source stubs (CI): same namespaces as the game, compile only.
       Real game DLLs take precedence; this runs only when UseGameStubs=true.
       BepInEx/Jotunn/Harmony still resolve from the real DLLs above.
       Private=false keeps the fake DLL out of the output, deploy, and zip. -->
  <ItemGroup Condition="'$(UseGameStubs)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Valheim/ValheimStubs\ValheimStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Warn (not error) when the game is absent: stub builds compile but the
       DLLs only resolve against the real game at runtime. -->
  <Target Name="CheckGameRefs" BeforeTargets="BeforeBuild">
    <Message Condition="'$(UseGameStubs)' == 'true'"
             Text="Compiling against minimal Valheim stubs (no game install). Game behavior is faked for compile only." />
  </Target>

  <!-- Copy the built plugin into the BepInEx plugins folder. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <PropertyGroup>
      <_DeployDir>$(PluginDeployDir)\$(DeployFolderName)</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Target DLL/pdb plus any copy-local dependencies (e.g. OdinsAi.Core.dll).
           Stub compile outputs (UnityEngine/assembly_valheim fakes) are excluded:
           they flow in transitively via ValheimStubs despite Private=false. -->
      <_ModFiles Include="$(TargetDir)*.dll" />
      <_ModFiles Remove="$(TargetDir)UnityEngine.dll" />
      <_ModFiles Remove="$(TargetDir)assembly_valheim.dll" />
      <_ModFiles Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(_DeployDir)" />
    <Copy SourceFiles="@(_ModFiles)" DestinationFolder="$(_DeployDir)" />
    <Message Importance="high" Text="Deployed $(ProjectName) to $(_DeployDir)" />
  </Target>

  <!-- Optionally package an importable (Thunderstore/r2modman) zip. -->
  <Target Name="Package" AfterTargets="Build" Condition="'$(PackageOnBuild)' == 'true'">
    <PropertyGroup>
      <_PackageStage>$(IntermediateOutputPath)package/</_PackageStage>
      <_ArtifactsDir>$(ProjectDir)artifacts/</_ArtifactsDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Target DLL plus copy-local dependencies (e.g. OdinsAi.Core.dll).
           Stub compile outputs excluded (see Deploy above). -->
      <_PackageFiles Include="$(TargetDir)*.dll" />
      <_PackageFiles Remove="$(TargetDir)UnityEngine.dll" />
      <_PackageFiles Remove="$(TargetDir)assembly_valheim.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(_PackageStage)" />
    <MakeDir Directories="$(_PackageStage)plugins" />
    <Copy SourceFiles="@(_PackageFiles)" DestinationFolder="$(_PackageStage)plugins" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/manifest.json" DestinationFolder="$(_PackageStage)" Condition="Exists('$(MSBuildProjectDirectory)/manifest.json')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../README.md" DestinationFolder="$(_PackageStage)" Condition="Exists('$(MSBuildProjectDirectory)/../README.md')" />
    <MakeDir Directories="$(_ArtifactsDir)" />
    <ZipDirectory SourceDirectory="$(_PackageStage)"
                  DestinationFile="$(_ArtifactsDir)$(ProjectName).zip"
                  Overwrite="true" />
    <Message Importance="high" Text="Packaged $(_ArtifactsDir)$(ProjectName).zip" />
  </Target>

</Project>
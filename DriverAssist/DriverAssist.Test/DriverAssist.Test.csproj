<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Tests run on net48 (not the game's net46): TUnit needs net462+.
      The shipped DriverAssist.dll stays on net46 to match the game.
    -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>CS8602,CS8629</NoWarn>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <_FindDependencies>true</_FindDependencies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.67.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DriverAssist\DriverAssist.csproj" />
    <ProjectReference Include="..\..\Common\Common.csproj" />
  </ItemGroup>
</Project>
